MUSIC_HOST=0.0.0.0
MUSIC_PORT=8788
MUSIC_DATA_DIR=/data
WATCH_DEVICE_TOKENS=watch-001=replace-with-device-token
MUSIC_TEST_MODE=false
MUSIC_TEST_STREAM_PATH=/data/test.mp3
NETEASE_COOKIE_PATH=/data/netease-cookie.txt
FFMPEG_PATH=ffmpeg
# Only the Hermes MCP client uses this token. Never put it in firmware or logs.
MUSIC_MCP_TOKEN=replace-with-hermes-mcp-token
MUSIC_MCP_DEVICE_ID=watch-001
MUSIC_REMOTE_COMMAND_TTL_MS=30000
MUSIC_MCP_ACK_WAIT_MS=5000
